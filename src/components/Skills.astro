---
interface Skill {
  name: string;
  icon: string;
}

const backendLanguages: Skill[] = [
  { name: "Java", icon: "/icons/java.png" },
  { name: "C#", icon: "/icons/cshar.webp" },
  { name: "TypeScript", icon: "/icons/typescript.png" },
];

const backendFrameworks: Skill[] = [
  { name: "Spring Boot", icon: "/icons/springboot.png" },
  { name: "NestJS", icon: "/icons/nestjs.svg" },
  { name: ".NET", icon: "/icons/net.png" },
  { name: "NodeJS", icon: "/icons/node.svg" },
  {name: "Play Framework", icon: "/icons/play_framework.svg" },
];

const backendDatabases: Skill[] = [
  { name: "MySQL", icon: "/icons/mysql.png" },
  { name: "SQL", icon: "/icons/sql.png" },
  { name: "PostgreSQL", icon: "/icons/postgres.webp" },
];

const frontendLanguages: Skill[] = [
  { name: "JavaScript", icon: "/icons/js.png" },
];

const frontendFrameworks: Skill[] = [
  { name: "NextJS", icon: "/icons/nextjs.png" },
  { name: "Tailwind CSS", icon: "/icons/tailwind.png" },
  {name: "Astro", icon: "/icons/astro.webp" },
];

const frontendTech: Skill[] = [
  { name: "HTML", icon: "/icons/html.png" },
  { name: "CSS", icon: "/icons/css.png" },
];

const cmsSkills: Skill[] = [
  { name: "WordPress", icon: "/icons/wordpress.png" },
  { name: "Shopify", icon: "/icons/shopify.webp" },
];

const devopsSkills: Skill[] = [
  { name: "Ubuntu Server", icon: "/icons/ubuntu.png" },
  { name: "Windows Server", icon: "/icons/windows.webp" },
];

const toolsSkills: Skill[] = [
  { name: "GitHub", icon: "/icons/github.png" },
  { name: "Azure DevOps", icon: "/icons/azure.png" },
  { name: "Git", icon: "/icons/git.png" },
];
---

<section
  id="skills"
  class="py-20 bg-gray-100 dark:bg-gray-900 transition-colors duration-300"
>
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-center text-3xl font-bold text-orange mb-16 font-monospace">
      Habilidades
    </h2>

    <div class="space-y-20">

      <!-- Backend -->
      <div>
        <h3 class="text-2xl font-semibold text-black dark:text-white mb-10 text-center font-monospace">
          Backend
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h4 class="text-lg font-medium text-orange mb-6 text-center">Lenguajes</h4>
            <div class="flex flex-wrap justify-center gap-6">
              {backendLanguages.map((skill) => (
                <div class="skill-item relative group">
                  <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                    <img src={skill.icon} alt={skill.name} class="h-14 w-14 object-contain" />
                  </div>
                  <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-orange px-3 py-1 rounded text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">
                    {skill.name}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-lg font-medium text-orange mb-6 text-center">Frameworks</h4>
            <div class="flex flex-wrap justify-center gap-6">
              {backendFrameworks.map((skill) => (
                <div class="skill-item relative group">
                  <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                    <img src={skill.icon} alt={skill.name} class="h-14 w-14 object-contain" />
                  </div>
                  <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-orange px-3 py-1 rounded text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">
                    {skill.name}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-lg font-medium text-orange mb-6 text-center">Bases de Datos</h4>
            <div class="flex flex-wrap justify-center gap-6">
              {backendDatabases.map((skill) => (
                <div class="skill-item relative group">
                  <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                    <img src={skill.icon} alt={skill.name} class="h-14 w-14 object-contain" />
                  </div>
                  <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-orange px-3 py-1 rounded text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">
                    {skill.name}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Frontend -->
      <div>
        <h3 class="text-2xl font-semibold text-black dark:text-white mb-10 text-center font-monospace">
          Frontend
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h4 class="text-lg font-medium text-orange mb-6 text-center">Lenguajes</h4>
            <div class="flex flex-wrap justify-center gap-6">
              {frontendLanguages.map((skill) => (
                <div class="skill-item relative group">
                  <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                    <img src={skill.icon} alt={skill.name} class="h-14 w-14 object-contain" />
                  </div>
                  <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-orange px-3 py-1 rounded text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">
                    {skill.name}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-lg font-medium text-orange mb-6 text-center">Frameworks</h4>
            <div class="flex flex-wrap justify-center gap-6">
              {frontendFrameworks.map((skill) => (
                <div class="skill-item relative group">
                  <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                    <img src={skill.icon} alt={skill.name} class="h-14 w-14 object-contain" />
                  </div>
                  <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-orange px-3 py-1 rounded text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">
                    {skill.name}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div>
            <h4 class="text-lg font-medium text-orange mb-6 text-center">Tecnologías</h4>
            <div class="flex flex-wrap justify-center gap-6">
              {frontendTech.map((skill) => (
                <div class="skill-item relative group">
                  <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                    <img src={skill.icon} alt={skill.name} class="h-14 w-14 object-contain" />
                  </div>
                  <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-orange px-3 py-1 rounded text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">
                    {skill.name}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- CMS -->
      <div>
        <h3 class="text-2xl font-semibold text-black dark:text-white mb-10 text-center font-monospace">
          CMS
        </h3>
        <div class="flex flex-wrap justify-center gap-8">
          {cmsSkills.map((skill) => (
            <div class="skill-item relative group">
              <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                <img src={skill.icon} alt={skill.name} class="h-16 w-16 object-contain" />
              </div>
              <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-orange px-3 py-1 rounded text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">
                {skill.name}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- DevOps -->
      <div>
        <h3 class="text-2xl font-semibold text-black dark:text-white mb-10 text-center font-monospace">
          DevOps
        </h3>
        <div class="flex flex-wrap justify-center gap-8">
          {devopsSkills.map((skill) => (
            <div class="skill-item relative group">
              <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                <img src={skill.icon} alt={skill.name} class="h-16 w-16 object-contain" />
              </div>
              <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-orange px-3 py-1 rounded text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">
                {skill.name}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Herramientas -->
      <div class="pb-10">
        <h3 class="text-2xl font-semibold text-black dark:text-white mb-10 text-center font-monospace">
          Herramientas <span class="text-orange">Relevantes</span>
        </h3>
        <div class="flex flex-wrap justify-center gap-8">
          {toolsSkills.map((skill) => (
            <div class="skill-item relative group">
              <div class="bg-white dark:bg-gray-800 p-4 rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                <img src={skill.icon} alt={skill.name} class="h-16 w-16 object-contain" />
              </div>
              <div class="absolute -top-10 left-1/2 transform -translate-x-1/2 bg-orange px-3 py-1 rounded text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">
                {skill.name}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .font-monospace {
    font-family: 'Space Mono', monospace;
  }
</style>
